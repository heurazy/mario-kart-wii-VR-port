@@ -0,0 +1,28 @@
+using WheelWizard.Services.Launcher;
+using Xunit;
+
+namespace WheelWizard.Test.Features.Recomp;
+
+public class LocalVrLaunchDiagnosticsTests
+{
+    [Fact]
+    public void MissingHeadsetDoesNotRecommendRecompilation()
+    {
+        var message = LocalVrLaunchDiagnostics.Classify("xrGetSystem failed: XR_ERROR_FORM_FACTOR_UNAVAILABLE", 1);
+        Assert.Contains("could not detect the headset", message);
+        Assert.Contains("Reinstalling the game will not fix this", message);
+    }
+
+    [Fact]
+    public void GeneralXrFailureHasRuntimeInstructions()
+    {
+        Assert.Contains("runtime could not start", LocalVrLaunchDiagnostics.Classify("OpenXR is required but unavailable", 1));
+    }
+
+    [Fact]
+    public void UnknownFailureDoesNotInventCorruptInstallation()
+    {
+        Assert.Contains("exit code 5", LocalVrLaunchDiagnostics.Classify("", 5));
+        Assert.DoesNotContain("Use Update", LocalVrLaunchDiagnostics.Classify("", 5));
+    }
+}
diff --git a/WheelWizard.Test/Features/Recomp/LocalVrPathsTests.cs b/WheelWizard.Test/Features/Recomp/LocalVrPathsTests.cs
new file mode 100644
index 00000000..8c613126
--- /dev/null
+++ b/WheelWizard.Test/Features/Recomp/LocalVrPathsTests.cs
@@ -0,0 +1,89 @@
+using System.Text.Json;
+using WheelWizard.Services.Launcher;
+
+namespace WheelWizard.Test.Features.Recomp;
+
+public sealed class LocalVrPathsTests : IDisposable
+{
+    private readonly string root = Directory.CreateTempSubdirectory("WheelWizard-VR-tests-").FullName;
+    private string Launcher => Path.Combine(root, "WheelWizard");
+
+    public void Dispose() => Directory.Delete(root, recursive: true);
+
+    private static void State(string folder, string oldRoot, string pack)
+    {
+        Directory.CreateDirectory(folder);
+        File.WriteAllText(
+            Path.Combine(folder, "install-state.json"),
+            JsonSerializer.Serialize(new { InstallDir = oldRoot, RetroRewindRoot = pack })
+        );
+    }
+
+    [Fact]
+    public void InstalledLayoutSharesRuntimeConfigAndActualPack()
+    {
+        State(root, root, Path.Combine(root, "RetroRewind6"));
+        var paths = LocalVrPaths.Resolve(Launcher);
+        Assert.Equal(root, paths.InstallRoot);
+        Assert.Null(paths.PortableRoot);
+        Assert.Equal(
+            Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "WiiCompiled"),
+            paths.UserDataRoot
+        );
+        Assert.Equal(Path.Combine(root, "RetroRewind6"), paths.PackRoot);
+    }
+
+    [Fact]
+    public void PortableNestedInstallUsesParentUserData()
+    {
+        File.WriteAllText(Path.Combine(root, "portable.txt"), "");
+        var install = Path.Combine(root, "Install");
+        State(install, install, Path.Combine(install, "RetroRewind6"));
+        var paths = LocalVrPaths.Resolve(Launcher);
+        Assert.Equal(install, paths.InstallRoot);
+        Assert.Equal(root, paths.PortableRoot);
+        Assert.Equal(Path.Combine(root, "UserData"), paths.UserDataRoot);
+    }
+
+    [Fact]
+    public void MovedPortableRebasesPackWithoutUsingOldInstallation()
+    {
+        var old = Path.Combine(root, "old");
+        State(root, old, Path.Combine(old, "RetroRewind6"));
+        Assert.Equal(Path.Combine(root, "RetroRewind6"), LocalVrPaths.Resolve(Launcher).PackRoot);
+    }
+
+    [Fact]
+    public void MovedPortableAlsoRebasesSiblingPack()
+    {
+        File.WriteAllText(Path.Combine(root, "portable.txt"), "");
+        var install = Path.Combine(root, "Install");
+        var old = Path.Combine(root, "previousLocation");
+        State(install, Path.Combine(old, "Install"), Path.Combine(old, "RetroRewind6"));
+        Assert.Equal(Path.Combine(root, "RetroRewind6"), LocalVrPaths.Resolve(Launcher).PackRoot);
+    }
+
+    [Fact]
+    public void ExternalPackIsNeverRedirectedToInternalPack()
+    {
+        var install = Path.Combine(root, "Install");
+        var external = Path.Combine(root, "external", "RetroRewind6");
+        State(install, install, external);
+        Assert.Equal(external, LocalVrPaths.Resolve(Launcher).PackRoot);
+    }
+
+    [Fact]
+    public void ExistingRootWinsOverStrayInstallSubdirectory()
+    {
+        Directory.CreateDirectory(Path.Combine(root, "Install"));
+        State(root, root, Path.Combine(root, "RetroRewind6"));
+        Assert.Equal(root, LocalVrPaths.Resolve(Launcher).InstallRoot);
+    }
+
+    [Fact]
+    public void BrokenStateDoesNotCrashSettings()
+    {
+        File.WriteAllText(Path.Combine(root, "install-state.json"), "{");
+        Assert.Equal(Path.Combine(root, "RetroRewind6"), LocalVrPaths.Resolve(Launcher).PackRoot);
+    }
+}
