@@ -0,0 +1,40 @@
+namespace WheelWizard.Services.Launcher;
+
+public static class LocalVrLaunchDiagnostics
+{
+    public static string Classify(string transcript, int exitCode)
+    {
+        if (transcript.Contains("XR_ERROR_FORM_FACTOR_UNAVAILABLE", StringComparison.Ordinal))
+            return "SteamVR could not detect the headset. Connect Quest Link or Virtual Desktop, open SteamVR and wait until the headset is ready, then press Play again. Reinstalling the game will not fix this.";
+        if (transcript.Contains("OpenXR is required but unavailable", StringComparison.Ordinal))
+            return "The VR runtime could not start. Open SteamVR, connect the headset, then try again. See the session log for the OpenXR error.";
+        return $"The VR game stopped with exit code {exitCode}. This does not necessarily mean the installation needs repair. See the session log for the cause.";
+    }
+
+    public static string Describe(string profile, DateTime launchedUtc, int exitCode)
+    {
+        try
+        {
+            var logs = Path.Combine(LocalVrPaths.Current.UserDataRoot, "Logs");
+            if (Directory.Exists(logs))
+            {
+                var session = new DirectoryInfo(logs)
+                    .EnumerateDirectories(profile + "_*")
+                    .Where(d => d.CreationTimeUtc >= launchedUtc)
+                    .OrderByDescending(d => d.CreationTimeUtc)
+                    .FirstOrDefault();
+                if (session is not null)
+                {
+                    var path = Path.Combine(session.FullName, "console.log");
+                    using var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
+                    file.Seek(Math.Max(0, file.Length - 131072), SeekOrigin.Begin);
+                    using var reader = new StreamReader(file);
+                    return Classify(reader.ReadToEnd(), exitCode) + "\n\nLog: " + path;
+                }
+            }
+        }
+        catch (IOException) { }
+        catch (UnauthorizedAccessException) { }
+        return $"The VR launch failed (exit code {exitCode}) before a new session log was found. Check that SteamVR and the headset are ready. If setup reports an invalid product, repair that product.";
+    }
+}
diff --git a/WheelWizard/Services/Launcher/LocalVrLauncher.cs b/WheelWizard/Services/Launcher/LocalVrLauncher.cs
new file mode 100644
index 00000000..f641d2a2
--- /dev/null
+++ b/WheelWizard/Services/Launcher/LocalVrLauncher.cs
@@ -0,0 +1,144 @@
+using System.Diagnostics;
+using WheelWizard.Models.Enums;
+using WheelWizard.Mods;
+using WheelWizard.Recomp;
+using WheelWizard.Views;
+
+namespace WheelWizard.Services.Launcher;
+
+// Retro Rewind uses the full upstream install, patch and reconciliation workflow.
+public sealed class LocalVrLauncher(string title, string executableRelativePath, IModsLaunchService? mods = null) : ILauncher
+{
+    private static readonly SemaphoreSlim LaunchGate = new(1, 1);
+    public static bool IsLocalBundle => File.Exists(Path.Combine(AppContext.BaseDirectory, "vr-local.txt"));
+    public static string BundleRoot => LocalVrPaths.Current.BundleRoot;
+    public static string RuntimeDirectory => LocalVrPaths.Current.InstallRoot;
+    public static bool OperationInFlight => LaunchGate.CurrentCount == 0;
+    public static bool IsBusy => IsLocalBundle && (OperationInFlight || HasRunningGame());
+
+    private static bool HasRunningGame()
+    {
+        foreach (var name in new[] { "WiiCompiled", "RetroRewind" })
+        foreach (var process in Process.GetProcessesByName(name))
+        {
+            using (process)
+            {
+                try
+                {
+                    var path = process.MainModule?.FileName;
+                    if (
+                        path is not null
+                        && Path.GetFullPath(path)
+                            .StartsWith(
+                                Path.TrimEndingDirectorySeparator(RuntimeDirectory) + Path.DirectorySeparatorChar,
+                                StringComparison.OrdinalIgnoreCase
+                            )
+                    )
+                        return true;
+                }
+                catch (System.ComponentModel.Win32Exception)
+                {
+                    return true;
+                }
+                catch (InvalidOperationException) { }
+            }
+        }
+        return false;
+    }
+
+    private bool IsRetro => mods is not null;
+    private RecompLauncher Retro => App.Services.GetRequiredService<RecompLauncher>();
+    public string GameTitle => title;
+
+    public static LocalVrLauncher CreateRetro() =>
+        new("Retro Rewind VR", Path.Combine("RetroRewind", "RetroRewind.exe"), App.Services.GetRequiredService<IModsLaunchService>());
+
+    public async Task<WheelWizardStatus> GetCurrentStatus()
+    {
+        if (OperationInFlight)
+            return WheelWizardStatus.Ready;
+        if (IsRetro)
+            return await Retro.GetCurrentStatus();
+        return
+            File.Exists(Path.Combine(RuntimeDirectory, executableRelativePath))
+            && File.Exists(Path.Combine(RuntimeDirectory, "GameAssets", "DATA", "sys", "fst.bin"))
+            ? WheelWizardStatus.Ready
+            : WheelWizardStatus.NotInstalled;
+    }
+
+    public Task<OperationResult> Install() => Guard(IsRetro ? Retro.Install : RunSetup);
+
+    public Task<OperationResult> Update() => Guard(IsRetro ? Retro.Update : RunSetup);
+
+    public Task<OperationResult> ReinstallRetro() =>
+        Guard(async () =>
+        {
+            var progress = new WheelWizard.Views.Popups.Generic.ProgressWindow("Reinstalling Retro Rewind");
+            progress.Show();
+            OperationResult result;
+            try
+            {
+                result = await App
+                    .Services.GetRequiredService<WheelWizard.CustomDistributions.ICustomDistributionSingletonService>()
+                    .RetroRewind.ReinstallAsync(progress);
+            }
+            finally
+            {
+                progress.Close();
+            }
+            if (result.IsFailure)
+                return result;
+            return await Retro.Update();
+        });
+
+    public Task<OperationResult> Launch() =>
+        Guard(async () =>
+        {
+            if (IsRetro)
+                return await Retro.Launch();
+            var setup = Path.Combine(RuntimeDirectory, "WiiCompiled-Setup.exe");
+            if (!File.Exists(setup))
+                return Fail("The VR setup host is missing. Repair the installation.");
+            var launchedUtc = DateTime.UtcNow;
+            using var process = Process.Start(
+                new ProcessStartInfo(setup, "--launch-base") { WorkingDirectory = RuntimeDirectory, UseShellExecute = false }
+            );
+            if (process is null)
+                return Fail("The VR game could not start.");
+            await process.WaitForExitAsync();
+            return process.ExitCode == 0 ? Ok() : Fail(LocalVrLaunchDiagnostics.Describe("base", launchedUtc, process.ExitCode));
+        });
+
+    private static async Task<OperationResult> Guard(Func<Task<OperationResult>> action)
+    {
+        if (HasRunningGame())
+            return Fail("Close the running VR game before launching or updating.");
+        if (!await LaunchGate.WaitAsync(0))
+            return Fail("A VR game or installation is already running.");
+        try
+        {
+            return await action();
+        }
+        catch (Exception e)
+        {
+            return Fail("VR operation failed: " + e.Message);
+        }
+        finally
+        {
+            LaunchGate.Release();
+        }
+    }
+
+    private static async Task<OperationResult> RunSetup()
+    {
+        var installed = Path.Combine(RuntimeDirectory, "WiiCompiled-Setup.exe");
+        var setup = File.Exists(installed) ? installed : Path.Combine(BundleRoot, "WiiCompiled-VR-Setup.exe");
+        if (!File.Exists(setup))
+            return Fail("The VR setup executable is missing.");
+        using var process = Process.Start(new ProcessStartInfo(setup) { UseShellExecute = true });
+        if (process is null)
+            return Fail("The VR setup could not start.");
+        await process.WaitForExitAsync();
+        return process.ExitCode == 0 ? Ok() : Fail("VR setup did not complete.");
+    }
+}
diff --git a/WheelWizard/Services/Launcher/LocalVrPaths.cs b/WheelWizard/Services/Launcher/LocalVrPaths.cs
new file mode 100644
index 00000000..f4fef78b
--- /dev/null
+++ b/WheelWizard/Services/Launcher/LocalVrPaths.cs
@@ -0,0 +1,57 @@
+using System.Text.Json;
+
+namespace WheelWizard.Services.Launcher;
+
+// Shared by launch, updates, save/Mii management and settings.
+public sealed record LocalVrPaths(string BundleRoot, string InstallRoot, string? PortableRoot, string UserDataRoot, string PackRoot)
+{
+    public static LocalVrPaths Current => Resolve(AppContext.BaseDirectory);
+
+    public static LocalVrPaths Resolve(string launcherDirectory)
+    {
+        var bundle = Path.GetFullPath(Path.Combine(launcherDirectory, ".."));
+        var install =
+            File.Exists(Path.Combine(bundle, "install-state.json")) ? bundle
+            : Directory.Exists(Path.Combine(bundle, "Install")) ? Path.Combine(bundle, "Install")
+            : bundle;
+        string? portable = null;
+        for (var folder = new DirectoryInfo(install); folder is not null; folder = folder.Parent)
+        {
+            if (!File.Exists(Path.Combine(folder.FullName, "portable.txt")))
+                continue;
+            portable = folder.FullName;
+            break;
+        }
+        var data = portable is not null
+            ? Path.Combine(portable, "UserData")
+            : Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "WiiCompiled");
+        var pack = Path.Combine(install, "RetroRewind6");
+        try
+        {
+            var stateFile = Path.Combine(install, "install-state.json");
+            if (File.Exists(stateFile))
+            {
+                using var state = JsonDocument.Parse(File.ReadAllText(stateFile));
+                if (state.RootElement.TryGetProperty("RetroRewindRoot", out var rr) && rr.GetString() is { Length: > 0 } recorded)
+                {
+                    // Rebase internal packs after moving a portable folder. External packs stay external.
+                    if (state.RootElement.TryGetProperty("InstallDir", out var previous) && previous.GetString() is { Length: > 0 } old)
+                    {
+                        var oldBase =
+                            portable is not null && Path.GetRelativePath(portable, install) == "Install"
+                                ? Path.GetDirectoryName(Path.TrimEndingDirectorySeparator(old))!
+                                : old;
+                        var newBase = portable is not null && Path.GetRelativePath(portable, install) == "Install" ? portable : install;
+                        var relative = Path.GetRelativePath(oldBase, recorded);
+                        if (!Path.IsPathRooted(relative) && relative != ".." && !relative.StartsWith(".." + Path.DirectorySeparatorChar))
+                            recorded = Path.Combine(newBase, relative);
+                    }
+                    pack = Path.GetFullPath(recorded);
+                }
+            }
+        }
+        catch (JsonException) { } // Setup reports invalid state before launch.
+        catch (IOException) { }
+        return new(portable ?? bundle, install, portable, data, pack);
+    }
+}
