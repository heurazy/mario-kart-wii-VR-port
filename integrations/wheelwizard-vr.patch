+++ b/WheelWizard.Test/Features/LicenseRenameTests.cs
@@ -0,0 +1,91 @@
+using System.Reflection;
+using System.Text;
+using Testably.Abstractions.Testing;
+using WheelWizard.Models.Enums;
+using WheelWizard.Services;
+using WheelWizard.Settings;
+using WheelWizard.Settings.Types;
+using WheelWizard.Utilities.Generators;
+using WheelWizard.WheelWizardData;
+using WheelWizard.WiiManagement.GameLicense;
+using WheelWizard.WiiManagement.GameLicense.Domain;
+using WheelWizard.WiiManagement.MiiManagement;
+using WheelWizard.WiiManagement.MiiManagement.Domain.Mii;
+
+namespace WheelWizard.Test.Features;
+
+[Collection("SettingsFeature")]
+public sealed class LicenseRenameTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void RenamePreservesLicenseIdentityWithOrWithoutNandMii(bool hasMii)
+    {
+        var settings = Substitute.For<ISettingsManager>();
+        settings.LOAD_PATH.Returns(Substitute.For<Setting>(typeof(string), "load", ""));
+        settings.Get<string>(Arg.Any<Setting>()).Returns("");
+        settings.Get<MarioKartWiiEnums.Regions>(Arg.Any<Setting>()).Returns(MarioKartWiiEnums.Regions.Europe);
+        settings.PathsSetupCorrectly().Returns(true);
+        var runtime = typeof(SettingsRuntime).GetField("_current", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var previous = runtime.GetValue(null);
+        SettingsRuntime.Initialize(settings);
+        try
+        {
+            var fs = new MockFileSystem();
+            var miis = Substitute.For<IMiiDbService>();
+            var mii = new Mii { MiiId = 0x81234567, Name = new MiiName("Old") };
+            if (hasMii)
+                miis.GetByAvatarId(mii.MiiId).Returns(Ok(mii));
+            else
+                miis.GetByAvatarId(mii.MiiId).Returns(Fail("Mii block not found"));
+            miis.UpdateName(mii.MiiId, "New name").Returns(Ok());
+            var service = new GameLicenseSingletonService(
+                miis,
+                fs,
+                Substitute.For<IWhWzDataSingletonService>(),
+                Substitute.For<IRRratingReader>(),
+                settings
+            );
+            var data = new byte[0x2BC000];
+            Encoding.ASCII.GetBytes("RKSD0006RKPD").CopyTo(data, 0);
+            new byte[] { 0x81, 0x23, 0x45, 0x67 }.CopyTo(data, 8 + 0x28);
+            data[8 + 0x5C] = 12; // Online identity must survive.
+            data[8 + 0xB0] = 21; // Rating must survive.
+            var before = (byte[])data.Clone();
+            typeof(GameLicenseSingletonService)
+                .GetField("_rksysData", BindingFlags.Instance | BindingFlags.NonPublic)!
+                .SetValue(service, data);
+            service.LicenseCollection.Users.Add(
+                new LicenseProfile
+                {
+                    Mii = hasMii ? mii : null,
+                    FriendCode = "1234-5678-9012",
+                    Vr = 5000,
+                    Br = 5000,
+                    RegionId = 0,
+                    TotalRaceCount = 10,
+                    TotalWinCount = 2,
+                }
+            );
+            var result = service.ChangeMiiName(0, "New name");
+            Assert.True(result.IsSuccess, result.IsFailure ? result.Error.Message : "");
+            var saved = fs.File.ReadAllBytes(Path.Combine(PathManager.SaveFolderPath, "RMCP", "rksys.dat"));
+            Assert.Equal("New name", Encoding.BigEndianUnicode.GetString(saved, 8 + 0x14, 20).TrimEnd('\0'));
+            Assert.Equal("New name", service.LicenseCollection.Users[0].NameOfMii);
+            for (int i = 0; i < data.Length; i++)
+                if (!(i >= 28 && i < 48) && !(i >= 0x27FFC && i < 0x28000))
+                    Assert.Equal(before[i], saved[i]);
+            var checkedCrc = (byte[])saved.Clone();
+            GameLicenseSingletonService.FixRksysCrc(checkedCrc);
+            Assert.Equal(checkedCrc, saved);
+            miis.Received(hasMii ? 1 : 0).UpdateName(mii.MiiId, "New name");
+            Assert.True(service.ChangeMiiName(1, "Other").IsFailure);
+            Assert.True(service.ChangeMiiName(0, " ").IsFailure);
+        }
+        finally
+        {
+            runtime.SetValue(null, previous);
+        }
+    }
+}
