+    private async Task CheckVrUpdatesAsync()
+    {
+        var paths = WheelWizard.Services.Launcher.LocalVrPaths.Current;
+        var statePath = Path.Combine(paths.InstallRoot, "install-state.json");
+        if (!File.Exists(statePath))
+            return;
+        string? current;
+        try
+        {
+            using var state = System.Text.Json.JsonDocument.Parse(await File.ReadAllTextAsync(statePath));
+            current = state.RootElement.GetProperty("SetupVersion").GetString();
+        }
+        catch (Exception)
+        {
+            return;
+        }
+        if (!WheelWizard.Recomp.RecompVersion.TryParse(current, out var installed))
+            return;
+        var releases = await gitHubService.GetReleasesAsync("heurazy", "mario-kart-wii-VR-port", count: 100);
+        if (releases.IsFailure)
+            return;
+        var latest = WheelWizard.Recomp.RecompReleaseResolver.FindLatest(releases.Value);
+        if (latest is null || latest.Version.ComparePrecedenceTo(installed) <= 0)
+            return;
+        await Dispatcher.UIThread.InvokeAsync(async () =>
+        {
+            var accepted = await new YesNoWindow()
+                .SetMainText("Mario Kart Wii VR update available")
+                .SetExtraText(
+                    $"VR version {latest.TagName} is available (installed: {current}). Update the VR tools and rebuild from your PAL image."
+                )
+                .SetButtonText("Update VR", "Later")
+                .AwaitAnswer();
+            if (!accepted)
+                return;
+            var updater = Path.Combine(paths.BundleRoot, "Update-VR.cmd");
+            if (File.Exists(updater))
+                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(updater) { UseShellExecute = true });
+            else
+            {
+                var result = await WheelWizard.Services.Launcher.LocalVrLauncher.CreateRetro().Update();
+                if (result.IsFailure)
+                    await new MessageBoxWindow().SetTitleText("VR update failed").SetInfoText(result.Error.Message).ShowDialog();
+            }
+        });
+    }
+
     private async Task<GithubRelease?> GetLatestReleaseAsync()
     {
         var releasesResult = await gitHubService.GetReleasesAsync();
